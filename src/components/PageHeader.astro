---
import mark from '../assets/logo/mark-paths.json';

interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="relative overflow-hidden border-b border-pine/10 bg-mist">
  <svg
    class="pointer-events-none absolute -top-16 -right-36 w-[20rem] text-leaf/12 md:-top-32 md:right-[-4rem] md:w-[34rem] md:text-leaf/15"
    viewBox="0 0 100 100"
    aria-hidden="true"
  >
    <g fill="currentColor">
      {Object.values(mark).map((d) => <path d={d} />)}
    </g>
  </svg>
  <div class="shell relative py-16 md:py-24">
    <h1 class="max-w-3xl text-5xl md:text-6xl">{title}</h1>
    {intro && <p class="lede mt-5 max-w-2xl">{intro}</p>}
    <slot />
  </div>
</section>
