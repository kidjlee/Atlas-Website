---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  position?: string;
}

const { image, alt, position = '50% 50%' } = Astro.props;

// Same geometry as the logo mark (see scripts/build-logo.mjs), scaled up to frame the photo.
const polar = (radius: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  return `${(50 + radius * Math.cos(a)).toFixed(2)} ${(50 + radius * Math.sin(a)).toFixed(2)}`;
};
const ring = `M${polar(48, -28)} A48 48 0 1 1 ${polar(48, -82)} A44.2 44.2 0 1 0 ${polar(48, -28)}Z`;
---

<div class="hero-ring relative mx-auto aspect-square w-full max-w-[28rem] lg:max-w-[34rem]">
  <div class="hero-ring__photo absolute inset-[9%] overflow-hidden rounded-full bg-birch">
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[420, 640, 900]}
      sizes="(min-width: 1024px) 28rem, 80vw"
      class="size-full object-cover"
      style={`object-position: ${position}`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <svg class="hero-ring__frame absolute inset-0 size-full text-leaf" viewBox="0 0 100 100" aria-hidden="true">
    <path d={ring} fill="currentColor" />
  </svg>
  <svg
    class="hero-ring__leaf absolute top-[1%] right-[3%] w-[30%] text-leaf drop-shadow-[0_10px_18px_rgba(23,63,43,0.18)]"
    viewBox="26 20 48 32"
    aria-hidden="true"
  >
    <defs>
      <mask id="hero-leaf-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
        <rect x="0" y="0" width="100" height="100" fill="#fff" />
        <path d="M31.5 44.6 Q48 39.5 64.5 29.2" fill="none" stroke="#000" stroke-width="1.6" stroke-linecap="round" />
      </mask>
    </defs>
    <path d="M28.5 46 C35.5 29.5 52.5 21 71 25.5 C63 42.5 46 50.5 28.5 46Z" fill="currentColor" mask="url(#hero-leaf-cut)" />
  </svg>
</div>

<style>
  .hero-ring__frame {
    transform-origin: 50% 50%;
    animation: ring-in 1.4s var(--ease-out-soft) both;
  }
  .hero-ring__photo {
    animation: photo-in 1.1s var(--ease-out-soft) both;
  }
  .hero-ring__leaf {
    transform-origin: 0% 100%;
    animation: leaf-in 0.9s var(--ease-out-soft) 0.75s both;
  }

  @keyframes ring-in {
    from {
      opacity: 0;
      transform: rotate(-70deg);
    }
    to {
      opacity: 1;
      transform: rotate(0);
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes leaf-in {
    from {
      opacity: 0;
      transform: translate(-12%, 12%) rotate(-12deg) scale(0.8);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
