---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mark from '../assets/logo/mark-paths.json';

interface Props {
  image: ImageMetadata;
  alt: string;
  position?: string;
}

const { image, alt, position = '50% 50%' } = Astro.props;

// The photo circle sits inside the ring (all values are % of the frame, matching the
// mark's 100 x 100 box). The leaf is the logo's leaf, scaled down into the ring's opening.
const photo = { cx: 50, cy: 49, r: 34 };
---

<div class="hero-ring relative mx-auto aspect-square w-full max-w-[28rem] lg:max-w-[34rem]">
  <div
    class="hero-ring__photo absolute overflow-hidden rounded-full bg-birch"
    style={`left:${photo.cx - photo.r}%;top:${photo.cy - photo.r}%;width:${photo.r * 2}%;height:${photo.r * 2}%`}
  >
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 720, 1024]}
      sizes="(min-width: 1024px) 24rem, 60vw"
      quality={90}
      class="size-full object-cover"
      style={`object-position: ${position}`}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <svg class="hero-ring__frame absolute inset-0 size-full overflow-visible text-leaf" viewBox="0 0 100 100" aria-hidden="true">
    <g fill="currentColor" stroke="#fff" stroke-width="1.2" stroke-linejoin="round" paint-order="stroke">
      <path d={mark.ring} />
      <path d={mark.swoosh} />
    </g>
  </svg>
  <svg class="hero-ring__leaf absolute inset-0 size-full overflow-visible text-leaf" viewBox="0 0 100 100" aria-hidden="true">
    <g fill="currentColor" stroke="#fff" stroke-width="2" stroke-linejoin="round" paint-order="stroke" transform="translate(33 2.5) scale(0.6)">
      <path d={mark.leaf} />
    </g>
  </svg>
</div>

<style>
  .hero-ring__frame {
    transform-origin: 50% 50%;
    animation: ring-in 1.4s var(--ease-out-soft) both;
  }
  .hero-ring__photo {
    animation: photo-in 1.1s var(--ease-out-soft) both;
  }
  .hero-ring__leaf {
    transform-origin: 60% 20%;
    animation: leaf-in 0.9s var(--ease-out-soft) 0.75s both;
  }

  @keyframes ring-in {
    from {
      opacity: 0;
      transform: rotate(-70deg);
    }
    to {
      opacity: 1;
      transform: rotate(0);
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes leaf-in {
    from {
      opacity: 0;
      transform: translate(-4%, 4%) rotate(-10deg) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
