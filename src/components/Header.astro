---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import BookButton from './BookButton.astro';
import { clinic, nav } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (path: string) => url(path).replace(/\/$/, '') === current;
---

<header class="sticky top-0 z-40 border-b border-pine/10 bg-white/90 backdrop-blur-md supports-[backdrop-filter]:bg-white/80">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-pine focus:px-4 focus:py-2 focus:text-white"
  >
    Skip to content
  </a>
  <div class="shell flex h-18 items-center justify-between gap-6 lg:h-20">
    <a href={url()} class="shrink-0" aria-label={`${clinic.name} home`}>
      <Logo class="h-9 w-auto sm:h-10 lg:h-11" />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        nav.map((item) => (
          <a
            href={url(item.path)}
            aria-current={isActive(item.path) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-[1.0625rem] font-medium transition-colors',
              isActive(item.path) ? 'text-pine' : 'text-moss hover:text-pine',
            ]}
          >
            <span class:list={[isActive(item.path) && 'border-b-2 border-leaf pb-0.5']}>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={clinic.phone.href}
        class="flex items-center gap-2 font-semibold text-pine transition-colors hover:text-leaf-ink"
        aria-label={`Call ${clinic.phone.display}`}
      >
        <Icon name="phone" class="size-5 text-leaf" />
        {clinic.phone.display}
      </a>
      <BookButton label="Book appointment" class="min-h-11 px-5" />
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <a
        href={clinic.phone.href}
        class="hidden items-center gap-2 rounded-full px-3 py-2 font-semibold text-pine sm:flex"
        aria-label={`Call ${clinic.phone.display}`}
      >
        <Icon name="phone" class="size-5 text-leaf" />
        {clinic.phone.display}
      </a>
      <button
        type="button"
        class="inline-flex size-12 items-center justify-center rounded-full text-pine hover:bg-mist"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <Icon name="menu" class="size-6" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-pine/10 bg-white lg:hidden" data-menu>
    <nav aria-label="Mobile" class="shell flex flex-col py-4">
      {
        nav.map((item) => (
          <a
            href={url(item.path)}
            aria-current={isActive(item.path) ? 'page' : undefined}
            class:list={[
              'flex items-center justify-between border-b border-pine/10 py-4 font-display text-2xl',
              isActive(item.path) ? 'text-pine' : 'text-ink',
            ]}
          >
            {item.label}
            {isActive(item.path) && <span class="size-2 rounded-full bg-leaf" aria-hidden="true" />}
          </a>
        ))
      }
      <div class="flex flex-col gap-3 pt-6 pb-2 sm:flex-row">
        <BookButton class="w-full sm:w-auto" />
        <a href={clinic.phone.href} class="btn btn-secondary w-full sm:w-auto">
          <Icon name="phone" class="size-5" />
          Call {clinic.phone.display}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
    if (label) label.textContent = open ? 'Open menu' : 'Close menu';
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
      toggle.focus();
    }
  });
</script>
