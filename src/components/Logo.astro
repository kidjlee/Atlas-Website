---
import logoSvg from '../assets/logo/logo.svg?raw';

interface Props {
  class?: string;
  /** "dark" for white backgrounds, "light" for dark backgrounds. */
  tone?: 'dark' | 'light';
}

const { class: className = 'h-10 w-auto', tone = 'dark' } = Astro.props;

const svg = logoSvg.replace('<svg ', `<svg class="${className}" `);
---

<span class:list={['inline-flex', tone === 'light' ? 'text-white' : 'text-ink']} set:html={svg} />
