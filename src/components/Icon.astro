---
type Name = 'phone' | 'calendar' | 'pin' | 'clock' | 'mail' | 'message' | 'menu' | 'close' | 'directions';

interface Props {
  name: Name;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const paths: Record<Name, string> = {
