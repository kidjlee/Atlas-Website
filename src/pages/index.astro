---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroRing from '../components/HeroRing.astro';
import BookButton from '../components/BookButton.astro';
import PhoneLink from '../components/PhoneLink.astro';
import HoursTable from '../components/HoursTable.astro';
import StaffCard from '../components/StaffCard.astro';
import BookingBand from '../components/BookingBand.astro';
import Icon from '../components/Icon.astro';
import ContactCards from '../components/ContactCards.astro';
import { clinic, formatPrice, maps, openDaysSummary, therapists, treatmentGroups } from '../data/site';
import { url } from '../lib/url';
import mark from '../assets/logo/mark-paths.json';

import heroPhoto from '../assets/photos/hero-shoulder.jpg';
import aboutPhoto from '../assets/photos/intro-back.jpg';
import storefront from '../assets/photos/exterior-night.jpg';

const highlights = [
  {
    title: 'Book online, any time',
    body: `Choose your therapist, treatment, and time on JaneApp. Prefer to talk to someone? Call or text ${clinic.phone.display}.`,
  },
  {
    title: 'ICBC claims',
    body: 'Initial and follow-up visits are available if you have an active ICBC claim.',
  },
  {
    title: 'Open weekends',
    body: `We’re open ${openDaysSummary}.`,
  },
];
---

<BaseLayout
  title="Atlas Massage Therapy | Registered Massage Therapy (RMT) in Abbotsford, BC"
  description="Atlas Massage Therapy is a registered massage therapy clinic in Abbotsford, BC. Book online with our Registered Massage Therapists (RMTs) or call (604) 835-5520. ICBC visits available."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="shell grid items-center gap-12 pt-10 pb-16 md:pt-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pt-20 lg:pb-24">
      <div class="max-w-xl">
        <h1 class="text-[2.75rem] leading-[1.05] sm:text-6xl lg:text-[4.25rem]">
          Registered massage therapy in Abbotsford, BC
        </h1>
        <p class="lede mt-6">
          Personalized, hands-on care from our Registered Massage Therapists, in a calm and welcoming space. Book online in
          a few minutes, or give us a call.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <BookButton class="sm:px-7" />
          <PhoneLink label={`Call ${clinic.phone.display}`} />
        </div>
        <p class="mt-6 text-base text-moss">{clinic.bookingNote}</p>
      </div>
      <HeroRing
        image={heroPhoto}
        alt="A massage therapist working on a client’s neck and shoulders"
      />
    </div>
  </section>

  <!-- About -->
  <section class="bg-mist">
    <div class="shell grid items-center gap-12 py-20 md:py-28 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div class="relative order-2 lg:order-1">
        <Picture
          src={aboutPhoto}
          alt="A Registered Massage Therapist treating a client’s back"
          formats={['avif', 'webp']}
          widths={[400, 633]}
          quality={90}
          sizes="(min-width: 1024px) 30rem, 90vw"
          class="aspect-[4/5] w-full rounded-t-[12rem] rounded-b-round object-cover lg:aspect-[3/4]"
          loading="lazy"
        />
      </div>
      <div class="order-1 lg:order-2">
        <h2 class="text-4xl md:text-5xl">Hands-on care, tailored to you</h2>
        <div class="mt-6 space-y-4 text-lg text-moss">
          <p>
            Welcome to Atlas Massage Therapy, a registered massage therapy clinic in Abbotsford, BC. Our Registered
            Massage Therapists provide personalized care in a comfortable, welcoming environment.
          </p>
          <p>
            Whether you’re looking for relief from muscle tension, help managing discomfort, or support for your overall
            wellness, we’re here to help you feel your best.
          </p>
        </div>
        <ul class="mt-10 space-y-6">
          {
            highlights.map((h) => (
              <li class="flex gap-4">
                <svg class="mt-1 size-6 shrink-0 text-leaf" viewBox="22 2 56 46" aria-hidden="true">
                  <g fill="currentColor">
                    <path d={mark.leaf} />
                  </g>
                </svg>
                <div>
                  <h3 class="font-sans text-lg font-semibold text-pine">{h.title}</h3>
                  <p class="mt-1 text-moss">{h.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Treatments -->
  <section>
    <div class="shell grid gap-12 py-20 md:py-28 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-4xl md:text-5xl">Treatments and rates</h2>
        <p class="mt-5 text-lg text-moss">
          Choose a 30, 45, or 60 minute visit. You’ll see live availability for each therapist when you book on JaneApp.
        </p>
        <BookButton class="mt-8" />
      </div>
      <div class="space-y-12">
        {
          treatmentGroups.map((group) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b-2 border-pine pb-3">
                <h3 class="text-2xl md:text-3xl">{group.heading}</h3>
                {group.note && <p class="text-sm text-moss">{group.note}</p>}
              </div>
              <ul>
                {group.items.map((item) => (
                  <li class="flex items-baseline justify-between gap-6 border-b border-pine/10 py-4">
                    <span>
                      <span class="font-semibold text-ink">{item.name}</span>
                      <span class="ml-2 text-moss">{item.minutes} min</span>
                    </span>
                    {item.price != null && (
                      <span class="text-lg font-semibold text-pine tabular-nums">{formatPrice(item.price)}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-mist">
    <div class="shell py-20 md:py-28">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-4xl md:text-5xl">Meet your therapists</h2>
          <p class="mt-4 text-lg text-moss">
            Our Registered Massage Therapists are here to help. Book with the therapist of your choice, or pick any
            available time.
          </p>
        </div>
        <a href={url('our-team/')} class="text-link shrink-0">Meet the team</a>
      </div>
      <div class="mt-12 grid gap-12 sm:grid-cols-2 lg:gap-16">
        {therapists.map((t) => <StaffCard therapist={t} />)}
      </div>
    </div>
  </section>

  <!-- Visit -->
  <section>
    <div class="shell py-20 md:py-28">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold tracking-[0.2em] text-leaf-ink uppercase">Visit us</p>
        <h2 class="mt-3 text-4xl md:text-5xl">Hours and location</h2>
        <p class="mt-4 text-lg text-moss">
          Find us on Marshall Road in Abbotsford. Tap the card to call, email, or book.
        </p>
      </div>

      <div class="mx-auto mt-12 max-w-5xl md:mt-16">
        <ContactCards />
      </div>

      <div class="mx-auto mt-5 grid max-w-xl gap-5 lg:mt-8 lg:max-w-5xl lg:grid-cols-2 lg:gap-8">
        <figure class="overflow-hidden rounded-soft shadow-[0_24px_48px_-24px_rgba(15,45,30,0.45)]">
          <Picture
            src={storefront}
            alt="The Atlas Massage Therapy storefront at night, with its illuminated sign and reception area"
            formats={['avif', 'webp']}
            widths={[560, 1024]}
            quality={90}
            sizes="(min-width: 1024px) 31rem, 92vw"
            class="size-full object-cover"
            loading="lazy"
          />
        </figure>
        <div
          class="flex flex-col rounded-soft border border-pine/10 bg-white p-4 shadow-[0_24px_48px_-24px_rgba(15,45,30,0.25)] sm:p-8"
        >
          <HoursTable />
          <a href={maps.directions} target="_blank" rel="noopener" class="btn btn-secondary mt-6 w-full lg:mt-auto">
            <Icon name="directions" class="size-5" />
            Get directions
          </a>
        </div>
      </div>
    </div>
  </section>

  <BookingBand />
</BaseLayout>
